{
  "mcpServers": {
    "viirs": {
      "command": "ssh",
      "args": [
        "-o", "ServerAliveInterval=60",
        "-o", "ServerAliveCountMax=3",
        "-T",
        "YOUR_USERNAME@YOUR_SERVER_IP",
        "VIIRS_DUCKDB_PATH=/srv/viirs_database/VIIRS_Thermal_Database.duckdb ./Source/MCP/viirs_mcp_wrapper_final.sh"
      ],
      "transport": "stdio"
    },
    "aqueduct": {
      "command": "ssh",
      "args": [
        "-o", "ServerAliveInterval=60",
        "-o", "ServerAliveCountMax=3",
        "-T",
        "YOUR_USERNAME@YOUR_SERVER_IP",
        "./Source/MCP/aqueduct_mcp_wrapper_final.sh"
      ],
      "transport": "stdio"
    }
  }
}



